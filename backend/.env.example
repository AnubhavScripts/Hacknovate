# ================================
# SERVER
# ================================
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ================================
# MONGODB
# ================================
MONGODB_URI=mongodb://localhost:27017/merchantai
# Or Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/merchantai

# ================================
# SESSION SECRET
# ================================
SESSION_SECRET=replace_with_a_strong_random_secret

# ================================
# JWT
# ================================
JWT_SECRET=replace_with_jwt_secret

# ================================
# GOOGLE OAUTH 2.0
# Register at: https://console.cloud.google.com
# Authorized redirect URI: http://localhost:5000/auth/google/callback
# ================================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# ================================
# OPENAI
# ================================
OPENAI_API_KEY=your_openai_api_key

# ================================
# TWILIO (WhatsApp — optional, mocked if absent)
# ================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
